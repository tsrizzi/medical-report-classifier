# Ilustrativo para rodar a API localmente sem Docker (ex.: uvicorn direto).
# O docker-compose.yml define essas variaveis diretamente no servico e usa
# MODEL_BACKEND=onnx por padrao ali; o default "sklearn" abaixo e so para
# execucao local fora de container e nao precisa ser alterado.
MODEL_BACKEND=sklearn
MODELS_DIR=models
